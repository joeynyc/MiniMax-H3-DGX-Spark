+class _MiniMaxH3NF4Weight(nn.Module):
+    """A BitsAndBytes NF4 matrix with module-aware device movement.
+
+    The H3 text encoder uses custom tensor-parallel projections instead of
+    vLLM ``LinearBase`` layers, so the generic diffusion quantization hooks do
+    not see them.  Keep the packed bytes as a parameter and move the associated
+    BitsAndBytes quantization state alongside it when the encoder is offloaded.
+    """
+
+    def __init__(self, weight: torch.Tensor, quant_state: Any) -> None:
+        super().__init__()
+        self.weight = nn.Parameter(weight, requires_grad=False)
+        self.quant_state = quant_state
+        self.output_size = int(quant_state.shape[0])
+
+    @classmethod
+    def from_bf16(
+        cls,
+        weight: torch.Tensor,
+        *,
+        compress_statistics: bool,
+    ) -> _MiniMaxH3NF4Weight:
+        import bitsandbytes.functional as bnb_functional
+
+        packed, quant_state = bnb_functional.quantize_4bit(
+            weight.detach().contiguous(),
+            quant_type="nf4",
+            compress_statistics=compress_statistics,
+        )
+        return cls(packed, quant_state)
+
+    def _apply(self, fn, recurse: bool = True):
+        super()._apply(fn, recurse=recurse)
+        self.quant_state.to(self.weight.device)
+        return self
+
+    def forward(self, input_: torch.Tensor) -> torch.Tensor:
+        import bitsandbytes as bnb
+
+        original_shape = input_.shape
+        values = input_.reshape(-1, original_shape[-1])
+        output = bnb.matmul_4bit(
+            values,
+            self.weight.t(),
+            quant_state=self.quant_state,
+        )
+        return output.reshape(*original_shape[:-1], self.output_size).to(input_.dtype)
+
+    def storage_bytes(self) -> int:
+        tensors = [self.weight, self.quant_state.absmax, self.quant_state.code]
+        if self.quant_state.nested:
+            tensors.extend(
+                [
+                    self.quant_state.offset,
+                    self.quant_state.state2.absmax,
+                    self.quant_state.state2.code,
+                ]
+            )
+        return sum(tensor.numel() * tensor.element_size() for tensor in tensors)
+
+
+def _resolve_nf4_settings(quant_config: Any | None) -> tuple[bool, bool]:
+    """Return ``(enabled, compress_statistics)`` for the H3 text encoder."""
+
+    if quant_config is None:
+        return False, True
+    method = quant_config.get_name()
+    if method != "bitsandbytes":
+        return False, True
+    quant_type = str(getattr(quant_config, "quant_type", "nf4")).lower()
+    if quant_type != "nf4":
+        raise ValueError(f"MiniMax H3 text encoder requires BitsAndBytes NF4, got {quant_type!r}")
+    ignored_layers = list(getattr(quant_config, "ignored_layers", None) or [])
+    if ignored_layers:
+        raise ValueError("MiniMax H3 text encoder NF4 does not support ignored_layers")
+    return True, bool(getattr(quant_config, "compress_statistics", True))
+
