# Read MODEL-LICENSE.md before setting this to true.
MINIMAX_H3_LICENSE_ACKNOWLEDGED=false

# Absolute path containing the canonical curve-compressed FL2VA and Ref2VA
# directories. Full source checkpoints may be retained as FL2VA-Full and
# Ref2VA-Full for offline conversion/benchmarking; the launcher will not serve
# them as production partitions.
MINIMAX_H3_MODEL_ROOT=/absolute/path/to/MiniMax-H3

# Absolute path containing optional LoRA adapter directories.
MINIMAX_H3_LORA_ROOT=/absolute/path/to/loras

# Select the H3 task partition. Both production partitions are required to be
# AdaLN curve-compressed so either mode retains auxiliary-model headroom. The
# extended FL2VA bundle enables the measured request-scoped Tutu 8-NFE adapter;
# set FL2VA only when deliberately serving the 20-step-only fallback partition.
H3_RIG_MODE=fl2va
H3_FL2VA_PARTITION=FL2VA-TutuCurve-Step100/model

# Optional Hugging Face cache shared with the container.
HF_CACHE_DIR=/absolute/path/to/.cache/huggingface

# Secure default: listen only on the DGX Spark itself.
H3_BIND_HOST=127.0.0.1
H3_API_PORT=8000
# One-Spark 50-step quality requests can exceed the upstream 600-second default.
H3_VIDEO_SYNC_TIMEOUT=7200

# Remote access is fail-closed. To opt in, read SECURITY.md, set a non-loopback
# H3_BIND_HOST, set H3_ALLOW_REMOTE_API=true, and generate a unique API key with:
#   openssl rand -hex 32
H3_ALLOW_REMOTE_API=false
H3_API_KEY=

# Verified full-compute default. The measured baseline and optional approximate
# Cache-DiT profile are documented in docs/REPRODUCIBILITY.md.
H3_DIFFUSION_ATTENTION_BACKEND=CUDNN_ATTN
H3_EXECUTION_MODE=compile
H3_CACHE_BACKEND=none
H3_CACHE_CONFIG=

# CUTLASS preserves the validated full-compute compile profile. Humming is a
# deterministic eager/no-cache alternative; select it only together with
# H3_EXECUTION_MODE=eager and H3_CACHE_BACKEND=none.
H3_LINEAR_BACKEND=CUTLASS

# Compile/load the production 768x448x56 kernel shapes before the API becomes
# ready. The named Docker volume keeps the compiled kernels across restarts.
# Set false only for startup troubleshooting; the first request will then pay
# the compilation cost.
H3_STARTUP_WARMUP=true
